# Konquered Kocktails — environment variables
#
# Copy to .env.local for local dev; set the same in the Vercel project.
#
# NOTE: this site no longer holds a Stripe key. The GoElev8 portal owns Stripe
# end to end — it creates every Checkout Session, for both the $200 booking
# deposit and merch. STRIPE_SECRET_KEY and KB_STRIPE_CONNECTED_ACCOUNT_ID used
# to live here; they are now portal-side concerns and must be set THERE, not
# in this project.

# ── /book ────────────────────────────────────────────────────────────
# SECRET. Tenant write key for the portal's /api/external/experience-*
# endpoints (availability, lead capture, deposit). The portal stores only
# sha256 of it, and it grants write access to this tenant's leads and
# bookings — so it must never reach the browser. Every call goes through our
# own /api/book/* server routes. Do NOT rename this with a NEXT_PUBLIC_
# prefix; that would publish it in the client bundle.
#
# Generated in the portal (Master Admin → tenant write keys). Add
# https://konqueredkocktails.com to the key's allowed_origins.
#
# Until this is set, /book runs in demo mode: provisional dates, clearly
# labelled, and no charge.
KK_PORTAL_WRITE_KEY=

# ── Portal wiring, shared by /book, /merch, and /portfolio ───────────
# Both have working defaults; set them only to point at a staging portal or
# if the tenant slug differs.
#
# The slug MUST match `clients.slug` in the portal. The tenant row is
# `konquered-balance` (the LLC), NOT `konquered-kocktails` — the portfolio
# endpoint happens to accept both via an alias, but the products endpoint
# only accepts the real slug. Use konquered-balance everywhere.
NEXT_PUBLIC_PORTAL_URL=https://portal.goelev8.ai
NEXT_PUBLIC_PORTAL_SLUG=konquered-balance

# Optional server-side override for the portal origin. Falls back to
# NEXT_PUBLIC_PORTAL_URL when unset. Useful if the server should reach the
# portal over a different hostname than the browser does.
# PORTAL_URL=

# ── Canonical origin ─────────────────────────────────────────────────
# Used for absolute URLs in metadata. Stripe return URLs are derived from the
# incoming request origin, so this is not load-bearing for checkout.
NEXT_PUBLIC_APP_URL=https://konqueredkocktails.com
