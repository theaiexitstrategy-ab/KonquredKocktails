# Konquered Kocktails — environment variables
#
# Copy to .env.local for local dev; set the same three in the Vercel project
# (Production + Preview) to take deposits live.

# Canonical site origin. Used to build the Stripe Checkout return URLs in
# app/api/checkout/kbsetup/route.ts. If unset it falls back to
# https://www.goelev8.ai, which would send guests back to the wrong domain.
NEXT_PUBLIC_APP_URL=https://konqueredkocktails.com

# goElev8 platform Stripe secret key (sk_live_... / sk_test_...).
# Without it the checkout route returns 500.
STRIPE_SECRET_KEY=

# ── /merch storefront ────────────────────────────────────────────────
# The GoElev8 portal is the merch catalog. Both of these have working
# defaults, so /merch runs without them — set them only to point at a
# staging portal or if the tenant slug differs.
#
# The slug MUST match the `slug` column on the tenant's row in the portal's
# `clients` table. If they disagree the products endpoint returns 404
# tenant_not_found and the shelf shows its "being stocked" empty state.
NEXT_PUBLIC_PORTAL_URL=https://portal.goelev8.ai
NEXT_PUBLIC_PORTAL_SLUG=konquered-kocktails

# Konquered Balance's Stripe Connect account (acct_...). The $200 guest deposit
# is a destination charge to this account — Konquered Balance keeps 100% of the
# deposit minus the $10/booking platform fee.
#
# Until this is set the route deliberately returns 402 rather than falling back
# to a platform charge (which would route guest money into goElev8's balance).
# The page surfaces that as "Demo mode — no live charge". That is the intended
# pre-launch behavior.
KB_STRIPE_CONNECTED_ACCOUNT_ID=
